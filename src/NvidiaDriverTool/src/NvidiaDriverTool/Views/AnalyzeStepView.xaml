<UserControl x:Class="NvidiaDriverTool.Views.AnalyzeStepView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <StackPanel Margin="0,10,0,0">
        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                   Visibility="{Binding Status, Converter={StaticResource EmptyStrToVis}}"/>
        <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource StdBoolToVis}}"/>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource CautionCol}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding Error, Converter={StaticResource EmptyStrToVis}}"/>
        <Button Content="Retry" HorizontalAlignment="Left" Padding="16,7" Margin="0,10,0,0" Command="{Binding RetryCommand}"
                Visibility="{Binding Error, Converter={StaticResource EmptyStrToVis}}"/>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16"
                Visibility="{Binding Extracted, Converter={StaticResource StdBoolToVis}}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Package signature" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource GoodBadge}" HorizontalAlignment="Right"
                            Visibility="{Binding LooksTrusted, Converter={StaticResource StdBoolToVis}}">
                        <TextBlock Text="Verified NVIDIA" FontSize="10.5" Foreground="{StaticResource GoodCol}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Publisher}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0">
                    <Run Text="Found "/><Run Text="{Binding ComponentCount, Mode=OneWay}"/><Run Text=" installable components."/>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
