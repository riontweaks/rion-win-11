<UserControl x:Class="NvidiaDriverTool.Views.ReviewStepView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0">
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource CautionCol}" Margin="0,0,0,12"/>
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Keeping "/><Run Text="{Binding InstallCount, Mode=OneWay}"/><Run Text=" of "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" components."/>
                </TextBlock>
                <TextBlock Text="Excluded:" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                <TextBlock Text="{Binding ExcludedSummary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Installation options" Style="{StaticResource CardTitle}"/>
                <CheckBox Content="Unattended installation" IsChecked="{Binding Unattended}" IsEnabled="{Binding CanEditOptions}" Margin="0,12,0,8"/>
                <CheckBox Content="Clean installation — reset NVIDIA settings" IsChecked="{Binding CleanInstall}" IsEnabled="{Binding CanEditOptions}"/>
                <TextBlock Text="Clean installation erases settings from previous NVIDIA installations, including customized profiles. Leave it off to preserve your settings. It is not a full driver cleanup." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                <TextBlock Text="{Binding InstallationSummary}" TextWrapping="Wrap"/>
                <TextBlock Text="These choices apply to Install, Prepare and Export. Interactive setup lets you change selections again in NVIDIA's own installer." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Button Content="Prepare package · no installation" Command="{Binding PrepareCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,8"/><TextBlock Text="{Binding PreparationStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Export customized installer" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Choose any writable folder. A new folder will contain the complete package and a portable launcher with your exclusions. Vendor files stay intact. Live service changes and GPU tweaks are not included." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <WrapPanel><Button Content="Export installer to folder…" Command="{Binding ExportInstallerCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/><Button Content="Cancel export" Command="{Binding CancelExportCommand}" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/></WrapPanel>
        </StackPanel></Border>
        <TextBlock Text="Installing writes system drivers and services — this can't be fully undone without reinstalling NVIDIA's own unmodified package."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
</UserControl>
