<UserControl x:Class="NvidiaDriverTool.Views.SelectDriverStepView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <StackPanel Margin="0,10,0,0">
        <TextBlock Text="{Binding DetectionSummary}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
        <WrapPanel>
            <Button Content="Download Latest" Style="{StaticResource AccentButton}" Padding="18,9" Margin="0,0,10,0"
                    Command="{Binding DownloadCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <Button Content="Browse for a Driver File..." Padding="18,9"
                    Command="{Binding BrowseCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
        </WrapPanel>

        <ProgressBar Margin="0,16,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource StdBoolToVis}}"/>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   Visibility="{Binding Status, Converter={StaticResource EmptyStrToVis}}"/>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource CautionCol}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding Error, Converter={StaticResource EmptyStrToVis}}"/>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16"
                Visibility="{Binding HasSelection, Converter={StaticResource StdBoolToVis}}">
            <StackPanel>
                <TextBlock Text="Selected installer" Style="{StaticResource Label}"/>
                <TextBlock Text="{Binding SelectedFileName}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedFileSize}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
