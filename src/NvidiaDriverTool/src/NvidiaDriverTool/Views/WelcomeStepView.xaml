<UserControl x:Class="NvidiaDriverTool.Views.WelcomeStepView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:RadeonSoftwareSlimmer.Views;assembly=AmdDriverManager"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,10,0,16" MaxWidth="820" HorizontalAlignment="Left">
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="Detected GPU" Style="{StaticResource Label}"/>
                <TextBlock Text="{Binding GpuName}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CautionBadge}" Margin="0,12,0,0" HorizontalAlignment="Left"
                Visibility="{Binding NonNvidiaWarning, Converter={StaticResource EmptyStrToVis}}">
            <TextBlock Text="{Binding NonNvidiaWarning}" Foreground="{StaticResource CautionCol}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <TextBlock Text="This tool downloads (or lets you browse to) an official NVIDIA driver package, extracts it, and lets you choose which components to install — the same approach as the AMD Driver Tool, for NVIDIA GPUs."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/>

        <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Caption}" Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <shared:DriverReleaseCard DataContext="{Binding ReleaseCard}"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
