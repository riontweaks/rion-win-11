<UserControl x:Class="NvidiaDriverTool.Views.InstallStepView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <DockPanel Margin="0,10,0,0">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Elapsed}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Top" Content="Run Install" Style="{StaticResource AccentButton}" Padding="18,9"
                HorizontalAlignment="Left" Margin="0,0,0,14"
                Command="{Binding RunCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Percent}" Margin="0,0,0,10"
                     Visibility="{Binding IsRunning, Converter={StaticResource StdBoolToVis}}"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{StaticResource CautionCol}"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding Error, Converter={StaticResource EmptyStrToVis}}"/>

        <Border Style="{StaticResource Card}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
