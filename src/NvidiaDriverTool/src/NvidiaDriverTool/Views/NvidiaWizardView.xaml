<UserControl x:Class="NvidiaDriverTool.Views.NvidiaWizardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:NvidiaDriverTool.Views"
        xmlns:vm="clr-namespace:NvidiaDriverTool.ViewModels"
        FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">


    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeStepViewModel}"><w:WelcomeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDriverStepViewModel}"><w:SelectDriverStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyzeStepViewModel}"><w:AnalyzeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomizeStepViewModel}"><w:CustomizeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewStepViewModel}"><w:ReviewStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallStepViewModel}"><w:InstallStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinishStepViewModel}"><w:FinishStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PostInstallStepViewModel}"><ContentControl Content="{Binding Content}"/></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,24,32,12">
            <TextBlock Style="{StaticResource Caption}">
                <Run Text="Step "/><Run Text="{Binding Current.Number, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding Steps.Count, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource H1}" Margin="0,2,0,0"/>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" Visibility="{Binding ShowAdvancedTools, Converter={StaticResource StdBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding MonitorStatus}" Style="{StaticResource Caption}"/>
                    <WrapPanel Margin="0,5,0,0">
                        <TextBlock Margin="0,0,20,0"><Run Text="GPU "/><Run Text="{Binding Metrics.GpuLoad.Value, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                        <TextBlock Margin="0,0,20,0"><Run Text="Temperature "/><Run Text="{Binding Metrics.GpuTemp.Value, Mode=OneWay}"/><Run Text=" °C"/></TextBlock>
                        <TextBlock Margin="0,0,20,0"><Run Text="Clock "/><Run Text="{Binding Metrics.GpuClock.Value, Mode=OneWay}"/><Run Text=" MHz"/></TextBlock>
                        <TextBlock Text="{Binding Metrics.Updated}" Style="{StaticResource Caption}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="32,0,32,0"/>

        <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="32,12">
            <Grid>
                <Button Content="Back" HorizontalAlignment="Left" Padding="20,7"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding Current.CanGoBack, Converter={StaticResource StdBoolToVis}}"/>
                <Button Content="{Binding Current.AdvanceLabel}" HorizontalAlignment="Right" Padding="22,7"
                        Style="{StaticResource AccentButton}" Command="{Binding NextCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
