<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tools="clr-namespace:RionHub.Modules.Tools"
                    xmlns:debloat="clr-namespace:RionHub.Modules.Tools.Debloat"
                    xmlns:installer="clr-namespace:RionHub.Modules.Tools.Windows"
                    xmlns:cards="clr-namespace:RionHub.Modules.Tools.General"
                    xmlns:motion="clr-namespace:RionHub.Shell">
    <debloat:AppIconConverter x:Key="InstallerLocalIcon"/>
    <installer:InstallerBrandIconConverter x:Key="InstallerBrandIcon"/>
    <ItemsPanelTemplate x:Key="ToolCardPanel"><cards:CardPanel MinCardWidth="340" Gutter="12"/></ItemsPanelTemplate>
    <!-- Scoped to utility pages; GPU and power controls keep their own templates. -->
    <Style x:Key="ToolHeading" TargetType="TextBlock">
        <Setter Property="motion:AppMotion.HeadingEntrance" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ToolTitle" TargetType="TextBlock" BasedOn="{StaticResource ToolHeading}">
        <Setter Property="motion:AppMotion.HeadingEntrance" Value="False"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/><Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ToolSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg2}"/><Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="ToolRow" TargetType="Border" BasedOn="{StaticResource ToolSurface}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True">
                    <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style></ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="{StaticResource AccentLight}"/><Setter TargetName="surface" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Bg0}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ToolTab" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,4"/><Setter Property="MinHeight" Value="38"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="14,8">
                <Grid><ContentPresenter VerticalAlignment="Center"/><Border x:Name="line" Height="2" Background="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,-7" Visibility="Collapsed"/></Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="tab" Property="Background" Value="{StaticResource AccentWash}"/><Setter TargetName="line" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="tab" Property="BorderBrush" Value="{StaticResource AccentLight}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolAction" TargetType="FrameworkElement">
        <Setter Property="Grid.Column" Value="1"/><Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="20,0,0,0"/>
        <Style.Triggers><Trigger Property="tools:ToolLayout.IsCompact" Value="True">
            <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/><Setter Property="HorizontalAlignment" Value="Left"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ToolCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="ToolSwitch" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="44"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="focus" BorderBrush="Transparent" BorderThickness="2" Padding="3" CornerRadius="16">
                <Grid Width="40" Height="22">
                    <Border x:Name="track" Background="{StaticResource Bg0}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="11"/>
                    <Border x:Name="knob" Background="{StaticResource TextDim}" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="7"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="knob" Property="Background" Value="{StaticResource Bg0}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="BorderBrush" Value="{StaticResource AccentLight}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ToolInstallRow">
        <Border Style="{StaticResource ToolRow}" Margin="0" Padding="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource ToolCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}"/>
                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource Bg0}" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid Margin="6">
                        <TextBlock Text="{Binding IconInitials}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Source, ElementName=localArtwork}" Value="{x:Null}"/><Condition Binding="{Binding Source, ElementName=brandArtwork}" Value="{x:Null}"/><Condition Binding="{Binding IconGlyph}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentLight}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Source, ElementName=localArtwork}" Value="{x:Null}"/><Condition Binding="{Binding Source, ElementName=brandArtwork}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Image x:Name="brandArtwork" Source="{Binding Name, Converter={StaticResource InstallerBrandIcon}}" Stretch="Uniform"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=localArtwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                        <Image x:Name="localArtwork" Source="{Binding IconPath, Converter={StaticResource InstallerLocalIcon}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" Style="{StaticResource ToolTitle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource ToolCaption}" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
