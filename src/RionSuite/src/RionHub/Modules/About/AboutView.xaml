<UserControl x:Class="RionHub.Modules.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:GlassKit"
             FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="30,22,30,14">
            <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="ABOUT"/>
            
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,0,20,20">
            <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                    <!-- identity -->
                    <ContentControl Style="{StaticResource CardRaised}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="AppLogo" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource H1}" FontSize="26" Text="Rion Win 11"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,18,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="VERSION"/>
                                    <TextBlock Style="{StaticResource Mono}" Margin="0,4,0,0"
                                               Foreground="{StaticResource Text}" Text="{Binding AppVersion}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="INSTALLED DATE"/>
                                    <TextBlock Style="{StaticResource Mono}" Margin="0,4,0,0"
                                               Foreground="{StaticResource Text}" Text="{Binding InstalledDate}" ToolTip="Date this portable executable was created in its current location."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ContentControl>
                    <!-- credits: this app is a GPL-3.0 fork, so this is an obligation, not a nicety -->
                    <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="CREDITS AND LICENSING"
                               Margin="0,10,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5"
                                       Text="RadeonSoftwareSlimmer"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="The driver tool began as a fork of RadeonSoftwareSlimmer 1.12.0 by Greg Seaton, licensed GPL-3.0. Rion Win 11 is distributed under the same licence."/>
                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,14"/>
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Vendor SDKs"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="AMD ADLX and NVIDIA NVAPI are bound at runtime from the installed graphics driver. Neither library is redistributed with this application."/>
                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,14"/>
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Typography"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Barlow Bold headings and Source Sans 3 body text are embedded under the SIL Open Font License. License notices are included with the app. Windows supplies icon and diagnostic font fallbacks."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- system information and links -->
                <StackPanel Grid.Row="1" Margin="0,18,12,0">
                    <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="THIS PC" Margin="0,0,0,10"/>
                    <ContentControl Style="{StaticResource CardRaised}" Padding="18,16" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding SystemInfo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}"/>
                                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Text}" Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="190"
                                                   ToolTip="{Binding Value}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ContentControl>

                    <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="LINKS" Margin="0,6,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Content="Licenses and notices" Click="Licenses_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="10,9" Click="Discord_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock Text="Join the Discord" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
