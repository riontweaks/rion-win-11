<?xml version="1.0" encoding="utf-8"?>
<glass:GlassWindow x:Class="RionHub.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:glass="clr-namespace:GlassKit" xmlns:local="clr-namespace:RionHub" xmlns:shellns="clr-namespace:RionHub.Shell" shellns:AppMotion.Mode="Off" Title="Rion Win 11" Height="860" Width="1280" MinHeight="400" MinWidth="560" Icon="pack://application:,,,/Rion Win 11;component/Assets/rion.ico" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False" Background="#00FFFFFF" ResizeMode="CanResize" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.DataContext>
    <local:ShellViewModel />
  </FrameworkElement.DataContext>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ToastProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Border Name="root" Background="{TemplateBinding Control.Background}" CornerRadius="2" ClipToBounds="True">
                <Grid>
                  <Rectangle Name="PART_Track" />
                  <Decorator Name="PART_Indicator" HorizontalAlignment="Left">
                    <Grid>
                      <Border Name="fill" CornerRadius="2" Background="{StaticResource AccentFillGloss}" />
                      <Rectangle Name="PART_GlowRect" Width="60" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentFillGloss}" />
                    </Grid>
                  </Decorator>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ProgressBar.IsIndeterminate" Value="True">
                  <Setter TargetName="fill" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="ProgressBar.IsIndeterminate" Value="False">
                  <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Collapsed" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="PlainToastTemplate">
        <Border BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,6,0,0" MaxWidth="320" Background="{StaticResource ScrimSolid}" BorderBrush="{StaticResource GlossEdge}">
          <Grid ToolTip="{Binding Message}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Ellipse}">
                  <Setter Property="Fill" Value="{StaticResource GoodCol}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsError}">
                      <Setter Property="Fill" Value="{StaticResource CautionCol}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Ellipse>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Message}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="ProgressToastTemplate">
        <Border BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,6,0,0" MaxWidth="320" Background="{StaticResource ScrimSolid}" BorderBrush="{StaticResource GlossEdge}">
          <StackPanel>
            <Grid ToolTip="{Binding Message}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Ellipse}">
                    <Setter Property="Fill" Value="{StaticResource GoodCol}" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsError}">
                        <Setter Property="Fill" Value="{StaticResource CautionCol}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Ellipse>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Message}" />
            </Grid>
            <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100" Style="{StaticResource ToastProgressBarStyle}" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding HasDeterminateProgress, Converter={StaticResource InverseBool}}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <shellns:ToastTemplateSelector x:Key="ToastSelector" PlainTemplate="{StaticResource PlainToastTemplate}" ProgressTemplate="{StaticResource ProgressToastTemplate}" />
      <DataTemplate x:Key="TopTabTpl">
        <Button Style="{StaticResource TopTabButton}" Tag="{Binding RowTag}" AutomationProperties.Name="{Binding TopLabel}" Click="Tab_Click" />
      </DataTemplate>
      <DataTemplate x:Key="SubNavLeafTpl">
        <Button Style="{StaticResource RailItemButton}" Tag="{Binding Item.RowTag}" Command="{Binding Item.ActivateCommand}" AutomationProperties.Name="{Binding Title}">
          <Grid>
            <TextBlock Name="lbl" VerticalAlignment="Center" FontStretch="Normal" FontSize="13.5" TextWrapping="Wrap" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextDim}" Text="{Binding Title}" />
          </Grid>
        </Button>
        <DataTemplate.Triggers>
          <DataTrigger Value="active" Binding="{Binding Item.RowTag}">
            <Setter TargetName="lbl" Property="TextBlock.Foreground" Value="{StaticResource Text}" />
            <Setter TargetName="lbl" Property="TextBlock.FontWeight" Value="SemiBold" />
          </DataTrigger>
          <DataTrigger Value="True" Binding="{Binding Item.IsAction}">
            <Setter TargetName="lbl" Property="TextBlock.Foreground" Value="{StaticResource AccentLight}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="SubNavHeaderTpl">
        <TextBlock Margin="23,14,16,6" TextWrapping="Wrap" Style="{StaticResource Label}" Text="{Binding Title}" />
      </DataTemplate>
      <DataTemplate x:Key="SubNavTpl">
        <ContentControl Focusable="False" HorizontalContentAlignment="Stretch" Content="{Binding}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentControl}">
              <Setter Property="ContentTemplate" Value="{StaticResource SubNavLeafTpl}" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsHeader}">
                  <Setter Property="ContentTemplate" Value="{StaticResource SubNavHeaderTpl}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ContentControl>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootShell" CornerRadius="11" Background="{StaticResource Scrim}" BorderThickness="1" BorderBrush="{StaticResource GlossEdge}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Viewbox Width="26" Height="26" AutomationProperties.Name="Rion logo">
            <Canvas Width="26" Height="26">
              <Path Fill="{StaticResource Text}" Data="M5,8 L9,8 L9,10 C10,8 12,7 15,7 L15,11 C11,11 9,12 9,16 L9,21 L5,21" />
              <Ellipse Fill="{StaticResource Accent}" Width="4" Height="4" Canvas.Left="16" Canvas.Top="17" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="{Binding EditionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextTertiary}" Text="{Binding HeaderTitle}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click">
            <Canvas Width="12" Height="12">
              <Path Style="{StaticResource CaptionGlyph}" Data="M1,6 L11,6" />
            </Canvas>
          </Button>
          <Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click">
            <Canvas Width="12" Height="12">
              <Path Name="MaxGlyph" Style="{StaticResource CaptionGlyph}" Data="M1,1 H11 V11 H1 Z" />
            </Canvas>
          </Button>
          <Button Style="{StaticResource CaptionCloseButton}" AutomationProperties.Name="Close" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
            <Canvas Width="12" Height="12">
              <Path Style="{StaticResource CaptionGlyph}" Data="M1,1 L11,11 M11,1 L1,11" />
            </Canvas>
          </Button>
        </StackPanel>
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Divider}" />
      </Grid>
      <Grid Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemTemplate="{StaticResource TopTabTpl}" Margin="8,0" ItemsSource="{Binding Nav}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Grid.Column="1" Width="32" Height="32" Padding="0" Margin="8,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Read the guide for this page" ToolTip="Rion Docs — help for this page" Click="Help_Click">
              <Path Width="16" Height="16" Stroke="{StaticResource TextDim}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,1 A7,7 0 1 1 8,15A7,7 0 1 1 8,1M8,7 L8,12 M8,4 L8,4.5" />
            </Button>
            <Button Grid.Column="2" Margin="0,0,12,0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Join the Discord — https://discord.gg/5vtgShuks3" Click="Discord_Click">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="dbg" Background="{StaticResource ControlBg}" BorderBrush="{StaticResource BorderCol}" BorderThickness="1" CornerRadius="{StaticResource ChipRadius}" Padding="12,6" SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal">
                      <Path Width="18" Height="14" Stretch="Uniform" Fill="{StaticResource TextDim}" Data="M107.7,8.07 A105.15,105.15 0 0 0 81.47,0A72.06,72.06 0 0 0 78.11,6.83A97.68,97.68 0 0 0 49,6.83A72.37,72.37 0 0 0 45.64,0A105.89,105.89 0 0 0 19.39,8.09C2.79,32.65 -1.71,56.6 0.54,80.21 A105.73,105.73 0 0 0 32.71,96.35999999999999A77.7,77.7 0 0 0 39.6,85.24999999999999A68.42,68.42 0 0 1 28.75,80.07C29.66,79.41 30.55,78.72999999999999 31.41,78.07 A75.57,75.57 0 0 0 95.72999999999999,78.07C96.6,78.77999999999999 97.49,79.46 98.38999999999999,80.07 A68.68,68.68 0 0 1 87.51999999999998,85.25999999999999A77,77 0 0 0 94.40999999999998,96.35999999999999A105.25,105.25 0 0 0 126.59999999999998,80.21999999999998C129.23999999999998,52.83999999999999 122.08999999999997,29.109999999999985 107.69999999999999,8.069999999999979 M42.45,65.69 C36.18,65.69 31,60 31,53 C31,46 36,40.26 42.43,40.26 C48.86,40.26 54,46 53.89,53 C53.78,60 48.84,65.69 42.45,65.69 M84.69,65.69 C78.41,65.69 73.25,60 73.25,53 C73.25,46 78.25,40.26 84.69,40.26 C91.13,40.26 96.23,46 96.12,53 C96.01,60 91.08,65.69 84.69,65.69" />
                      <TextBlock Text="Community" Visibility="Collapsed" FontFamily="{StaticResource AppFont}" FontStretch="Normal" FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Control.Template>
            </Button>
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Margin="60,0" Background="{StaticResource SpecularSoft}" />
          </Grid>
        </Border>
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="168" Background="{StaticResource RailWash}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,11" Visibility="{Binding HasSubNav, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,10,0,0">
              <StackPanel DockPanel.Dock="Top" Margin="22,4,16,8">
                <TextBlock Style="{StaticResource SectionLabel}" glass:Tracking.Text="SECTION" />
                <TextBlock Style="{StaticResource H2}" FontSize="14" Margin="0,4,0,0" Text="{Binding SectionTitle, NotifyOnTargetUpdated=True}" />
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <ItemsControl ItemTemplate="{StaticResource SubNavTpl}" ItemsSource="{Binding SubNav}" />
                  <StackPanel Margin="10,12,10,8" Visibility="{Binding ShowDdu, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding Ddu.GetCommand}" ToolTip="{Binding Ddu.Status}" HorizontalContentAlignment="Left" Padding="8,6">
                      <StackPanel Orientation="Horizontal"><Image Source="/Rion Win 11;component/Assets/InstallerIcons/DisplayDriverUninstallerDDU.png" Width="20" Height="20" Margin="0,0,7,0"/>
                        <TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Get DDU"/><Style.Triggers><DataTrigger Binding="{Binding Ddu.IsInstalled}" Value="True"><Setter Property="Text" Value="Launch DDU"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Ddu.Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDim}" Margin="4,4,4,0"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource ContentWash}" CornerRadius="0,0,11,11">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <shellns:PageTransitionHost MinWidth="480" Content="{Binding ActiveContent}" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      <Grid Name="TourHost" Row="0" RowSpan="2" ZIndex="999" Visibility="{Binding Active, Converter={StaticResource BoolToVis}}">
        <Path Name="TourScrim" Fill="#C6060A12" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="8" Margin="{Binding RingMargin}" Width="{Binding RingWidth}" Height="{Binding RingHeight}" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}" />
        <Border Width="380" Background="{StaticResource ScrimSolid}" BorderBrush="{StaticResource GlossEdge}" BorderThickness="1" CornerRadius="10" Padding="18,16" HorizontalAlignment="{Binding BubbleHAlign}" VerticalAlignment="{Binding BubbleVAlign}" Margin="{Binding BubbleMargin}">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Opacity="0.7" Text="{Binding Progress}" />
            <TextBlock Style="{StaticResource H2}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Heading}" />
            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Text="{Binding Body}" />
            <Grid Margin="0,16,0,0">
              <Button Content="Skip tour" HorizontalAlignment="Left" Padding="12,6" Command="{Binding SkipCommand}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Padding="12,6" Margin="0,0,8,0" Command="{Binding BackCommand}" Visibility="{Binding CanBack, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource AccentButton}" Padding="18,6" Content="{Binding NextLabel}" Command="{Binding NextCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <ItemsControl Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1000" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" ItemTemplateSelector="{StaticResource ToastSelector}" ItemsSource="{Binding Toasts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Grid>
  </Border>
</glass:GlassWindow>

