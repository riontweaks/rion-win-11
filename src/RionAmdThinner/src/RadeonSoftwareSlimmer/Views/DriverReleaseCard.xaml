<UserControl x:Class="RadeonSoftwareSlimmer.Views.DriverReleaseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" FontFamily="{DynamicResource AppFont}">
    <Border Style="{StaticResource Card}" Padding="22" Margin="0,18,0,4">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="72" Height="72" CornerRadius="14" BorderBrush="#050608" BorderThickness="3" VerticalAlignment="Top">
                    
                    <Border CornerRadius="10" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <Border.Background><ImageBrush ImageSource="{Binding LogoUri}" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,5,0,7"/>
                    <TextBlock Text="{Binding Freshness}" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentHover}"/><Style.Triggers><DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource CautionCol}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,18,0,0" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource DisplayFont}" Text="{Binding VersionLabel}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,14,0" TextWrapping="Wrap"/>
                <Border CornerRadius="8" Background="#182E88FF" BorderBrush="#345C98DA" BorderThickness="1" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{Binding Channel}" Foreground="{StaticResource Text}" FontSize="12"/></Border>
            </WrapPanel>
            <WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding Released}" Foreground="{StaticResource TextDim}" Margin="0,0,18,5"/><TextBlock Text="{Binding Certification}" Foreground="{StaticResource TextDim}" Margin="0,0,18,5"/><TextBlock Text="{Binding Size}" Foreground="{StaticResource TextDim}" Margin="0,0,0,5"/></WrapPanel>
            <TextBlock Text="{Binding Stability}" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="12" LineHeight="18" Margin="0,9,0,0"/>
            <Border CornerRadius="10" Background="{StaticResource SurfaceSunk}" Padding="12" Margin="0,14,0,0">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAlternative}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel><TextBlock Text="{Binding AlternativeTitle}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="{Binding AlternativeSummary}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,6"/><Button Content="View release details" Command="{Binding OpenAlternativeCommand}" HorizontalAlignment="Left" Padding="10,4"/></StackPanel>
            </Border>
            <WrapPanel Margin="0,16,0,0"><Button Content="Install" Command="{Binding InstallCommand}" Style="{StaticResource AccentButton}" Padding="22,6" Margin="0,0,8,8" ToolTip="{Binding InstallHint}"/><Button Content="Release notes / known issues" Command="{Binding OpenNotesCommand}" Padding="12,6" Margin="0,0,8,8"/><Button Content="Official website" Command="{Binding OpenSourceCommand}" Padding="12,6" Margin="0,0,8,8"/><Button Content="Refresh now" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="{Binding InstallHint}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,6"/><TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,0"/>
            <Separator Margin="0,14,0,10" Background="{StaticResource Divider}"/>
            <TextBlock Text="{Binding Signature}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="{Binding SourceTrust}" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,6,0,0"/>
            <Expander Header="Selected installer signature and hash" Margin="0,8,0,0" Foreground="{StaticResource TextDim}"><TextBlock Text="{Binding SelectedPackage}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></Expander>
            <TextBlock Text="{Binding CheckedAt}" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,14,0,0"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
            <Border CornerRadius="10" Background="{StaticResource SurfaceSunk}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1" Padding="14" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Optimal &amp; alternative drivers" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RecommendationsReviewed}" Foreground="{StaticResource AccentHover}" FontSize="12" Margin="0,5,0,10"/>
                    <ComboBox ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedRecommendation}" IsEnabled="{Binding CanSelectRecommendation}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Previous recommended GPU driver version and release date"/>
                    <TextBlock Text="{Binding SelectedRecommendation.UseCase}" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontWeight="SemiBold" Margin="0,12,0,5"/>
                    <TextBlock Text="{Binding SelectedRecommendation.Evidence}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" LineHeight="18"/>
                    <TextBlock Text="{Binding SelectedRecommendation.Caveat}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" LineHeight="18" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Download &amp; install selected version" Command="{Binding InstallRecommendationCommand}" Style="{StaticResource AccentButton}" Padding="10,5" Margin="0,0,8,8"/>
                        <Button Content="Cancel download" Command="{Binding CancelRecommendationCommand}" Padding="10,5" Margin="0,0,8,8"/>
                        <Button Content="Official release notes" Command="{Binding OpenRecommendationNotesCommand}" Padding="10,5" Margin="0,0,8,8"/>
                        <Button Content="Recommendation evidence" Command="{Binding OpenRecommendationEvidenceCommand}" Padding="10,5" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="12" LineHeight="18" Margin="0,0,0,8"/>
                    <TextBlock Text="Curated history; live Refresh does not re-review community reports. Older drivers may lack later security and game fixes. Select a version, then use Download &amp; install selected version. Requires a detected compatible GPU. The Install button above still prepares the latest package." TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11" LineHeight="16"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
