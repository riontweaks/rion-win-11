<UserControl x:Class="RadeonSoftwareSlimmer.Views.DriverToolContentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:RadeonSoftwareSlimmer.Views.Wizard"
        xmlns:v="clr-namespace:RadeonSoftwareSlimmer.Views"
        xmlns:vm="clr-namespace:RadeonSoftwareSlimmer.ViewModels.Wizard"
        FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeStepViewModel}"><w:WelcomeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDriverStepViewModel}"><w:SelectDriverStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyzeStepViewModel}"><w:AnalyzeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomizeStepViewModel}"><w:CustomizeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewStepViewModel}"><w:ReviewStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PostInstallStepViewModel}"><w:PostInstallStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallStepViewModel}"><w:InstallStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinishStepViewModel}"><w:FinishStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PostInstallToolViewModel}"><w:PostInstallToolView/></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,24,32,12">
            <TextBlock Style="{StaticResource Caption}"
                       Visibility="{Binding IsOnWizardStep, Converter={StaticResource StdBoolToVis}}">
                <Run Text="Step "/><Run Text="{Binding Current.Number, Mode=OneWay}"/><Run Text=" of 8"/>
            </TextBlock>
            <TextBlock Text="{Binding ActiveTitle}" Style="{StaticResource H1}" Margin="0,2,0,0"/>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding ActiveContent}"/>

        <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="32,12"
                Visibility="{Binding IsOnWizardStep, Converter={StaticResource StdBoolToVis}}">
            <Grid>
                <Button Content="Back" HorizontalAlignment="Left" Padding="20,7"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding Current.CanGoBack, Converter={StaticResource StdBoolToVis}}"/>
                <Button Content="{Binding Current.AdvanceLabel}" HorizontalAlignment="Right" Padding="22,7"
                        Style="{StaticResource AccentButton}" Command="{Binding NextCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0">
            <v:MessageView Margin="32,7"/>
        </Border>
    </Grid>
</UserControl>
