<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.CustomizeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadeonSoftwareSlimmer.ViewModels.Wizard" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <UserControl.Resources>
        <DataTemplate x:Key="ComponentRow">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Keep}" IsEnabled="{Binding CanExclude}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ClassificationLabel}" FontSize="10.5" Style="{StaticResource Caption}"/>
                        </Border>
                    </Grid>
                    <Expander Header="Why this recommendation?" Margin="0,8,0,0" FontSize="12">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Visibility="{Binding ExclusionImpact, Converter={StaticResource NullToVis}}">
                                <Run Text="If excluded: " Foreground="{StaticResource CautionCol}"/><Run Text="{Binding ExclusionImpact, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Opacity="0.8">
                                <Run Text="Evidence: "/><Run Text="{Binding EvidenceLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Opacity="0.7"
                                       Visibility="{Binding HasSource, Converter={StaticResource StdBoolToVis}}">
                                <Run Text="Source: "/><Run Text="{Binding SourceTitle, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="32,6,32,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                       Text="Required items are locked on. Unknown items stay on by default. Nothing is removed until you confirm on the next page."/>
            <WrapPanel Margin="0,12,0,0" AutomationProperties.AutomationId="customize-presets">
                <Button Content="Default" Command="{Binding ApplyPresetCommand}" Margin="0,0,6,6"
                        ToolTip="Keep everything - a stock AMD install.">
                    <Button.CommandParameter><vm:InstallPreset>Default</vm:InstallPreset></Button.CommandParameter>
                </Button>
                <Button Content="Optimal Performance" Command="{Binding ApplyPresetCommand}" Margin="0,0,6,6"
                        ToolTip="Drop ReLive recording/streaming, AMD Link, the User Experience Program and update tasks. Keep display, audio and FreeSync / Anti-Lag.">
                    <Button.CommandParameter><vm:InstallPreset>OptimalPerformance</vm:InstallPreset></Button.CommandParameter>
                </Button>
                <Button Content="Minimal" Command="{Binding ApplyPresetCommand}" Margin="0,0,6,6"
                        ToolTip="Display driver plus HDMI/DisplayPort audio only.">
                    <Button.CommandParameter><vm:InstallPreset>Minimal</vm:InstallPreset></Button.CommandParameter>
                </Button>
                <Button Content="Restore Package Defaults" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,6,6"/>
            </WrapPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                <Run Text="Active preset: "/><Run Text="{Binding Preset, Mode=OneWay}"/>
                <Run Text="   ·   "/><Run Text="{Binding ExcludedCount, Mode=OneWay}"/><Run Text=" excluded"/>
                <Run Text="   ·   "/><Run Text="{Binding RulesVersion, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Packages" Style="{StaticResource H2}" Margin="0,4,0,4"/>
                <ItemsControl ItemsSource="{Binding Packages}" ItemTemplate="{StaticResource ComponentRow}"/>
                <TextBlock Text="No optional packages were found in this installer." Style="{StaticResource Caption}"
                           Margin="4,4" Visibility="{Binding Packages.Count, Converter={StaticResource ZeroToVis}}"/>

                <TextBlock Text="Scheduled tasks" Style="{StaticResource H2}" Margin="0,18,0,4"/>
                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource ComponentRow}"/>
                <TextBlock Text="No scheduled tasks defined in this installer." Style="{StaticResource Caption}"
                           Margin="4,4" Visibility="{Binding Tasks.Count, Converter={StaticResource ZeroToVis}}"/>

                <TextBlock Text="Display driver components" Style="{StaticResource H2}" Margin="0,18,0,4"/>
                <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentRow}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
