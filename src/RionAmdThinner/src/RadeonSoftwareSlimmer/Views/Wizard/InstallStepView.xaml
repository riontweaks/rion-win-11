<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.InstallStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                       Text="Complete AMD setup, then Rion checks the installed driver and applies your selected changes."/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Prepared installer" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorkspacePath}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Current driver" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVersion}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetVersion}" Margin="0,6,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Apply AMD GPU tweaks -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding ShowGpuTweaks, Converter={StaticResource StdBoolToVis}}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding ApplyGpuTweaks}" FontWeight="SemiBold" FontSize="13"
                              Content="Apply AMD GPU tweaks after the installation finishes"/>
                    <TextBlock Style="{StaticResource Caption}" Opacity="0.8" TextWrapping="Wrap" Margin="24,4,0,0"
                               Text="Curated, reversible registry changes. Undo data is saved so 'Revert last apply' can put them back. Needs administrator rights."/>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CautionCol}" Margin="24,6,0,0"
                               TextWrapping="Wrap" Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}"
                               Text="Not running as administrator - GPU tweaks will be skipped. Use 'Restart as administrator' on the left."/>

                    <Expander Header="Review optional GPU tweaks" Margin="24,12,0,0" IsExpanded="{Binding ApplyGpuTweaks, Mode=OneWay}">
                    <ItemsControl ItemsSource="{Binding GpuTweaks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,3">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Style="{StaticResource Caption}" Opacity="0.75" TextWrapping="Wrap" Margin="0,3,0,0">
                                                    <Run Text="Trade-off: "/><Run Text="{Binding TradeOff, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <Border Style="{StaticResource Pill}">
                                                    <TextBlock Text="{Binding EvidenceLabel}" FontSize="10" Style="{StaticResource Caption}"/>
                                                </Border>
                                                <TextBlock Text="{Binding StateNote}" FontSize="10" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,16,0,0">
                <Button Content="{Binding LaunchButtonText}" Style="{StaticResource AccentButton}" Padding="18,8"
                        Command="{Binding LaunchCommand}" AutomationProperties.AutomationId="install-launch"/>
                <Button Content="Open Monitor Window" Margin="8,0,0,0" Command="{Binding OpenMonitorCommand}"/>
                <Button Content="Open Prepared Folder" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
