<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.PostInstallStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:RadeonSoftwareSlimmer.Views" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                  >
        <StackPanel Margin="32,6,32,24">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                       Text="Choose which AMD services and scheduled tasks to disable. Nothing changes now - the Installation Monitor applies your selection automatically after the driver install verifies. Everything here is reversible (services are disabled, not deleted)."/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}"
                        ToolTip="Tick off the Optional AMD services and tasks the evidence-graded rules suggest disabling."/>
                <Button Content="Reload list" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <v:PostInstallView Margin="0,14,0,0" DataContext="{Binding Post}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
