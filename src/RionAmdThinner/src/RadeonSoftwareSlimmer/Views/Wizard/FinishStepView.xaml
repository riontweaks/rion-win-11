<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.FinishStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Setup complete." Style="{StaticResource H2}"/>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}"><Run Text="Driver installed"/></TextBlock>
                    <TextBlock Text="{Binding DriverInstalled}" Margin="0,2,0,0"/>

                    <TextBlock Text="Installer changes" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
                    <ItemsControl ItemsSource="{Binding Excluded}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Margin="0,2"><Run Text="Excluded: "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Core driver: Installed. Nothing else was excluded." Style="{StaticResource Caption}"
                               Visibility="{Binding AnythingExcluded, Converter={StaticResource InvBoolToVis}}"/>

                    <TextBlock Text="{Binding BackupNote}" Style="{StaticResource Caption}" Opacity="0.75"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Open AMD Software" Command="{Binding OpenAmdSoftwareCommand}"/>
                <Button Content="Export Report" Margin="8,0,0,0" Command="{Binding ExportReportCommand}"/>
                <Button Content="Open Session Folder" Margin="8,0,0,0" Command="{Binding OpenSessionFolderCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
