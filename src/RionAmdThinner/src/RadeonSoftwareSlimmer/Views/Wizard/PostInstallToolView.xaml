<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.PostInstallToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:RadeonSoftwareSlimmer.Views" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,28" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Blurb}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13">
                            <Run Text="GPU  " Foreground="{StaticResource TextTertiary}"/>
                            <Run Text="{Binding Gpu, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,3,0,0">
                            <Run Text="Driver  " Foreground="{StaticResource TextTertiary}"/>
                            <Run Text="{Binding DriverVersion, Mode=OneWay}"/>
                            <Run Text="     AMD Software  " Foreground="{StaticResource TextTertiary}"/>
                            <Run Text="{Binding AmdSoftwareVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Stop Radeon Software now" Command="{Binding StopRadeonSoftwareCommand}" Margin="0,0,6,0"/>
                        <Button Content="Reload" Command="{Binding ReloadCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RadeonSoftwareSlimmer post-install engine — services, tasks, host processes,
                 installed entries, temp files. It has its own immediate Apply button. -->
            <v:PostInstallView DataContext="{Binding Post}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
