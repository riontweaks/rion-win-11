<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.WelcomeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:RadeonSoftwareSlimmer.Views" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Choose a driver, then install it or customize its components."
                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="15"/>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{StaticResource CautionCol}"
                    Visibility="{Binding ShowOemWarning, Converter={StaticResource StdBoolToVis}}">
                <TextBlock Text="{Binding OemWarning}" TextWrapping="Wrap" Foreground="{StaticResource CautionCol}"/>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{StaticResource CautionCol}"
                    Visibility="{Binding NonAmdWarning, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding NonAmdWarning}" TextWrapping="Wrap" Foreground="{StaticResource CautionCol}"/>
            </Border>

            <shared:DriverReleaseCard DataContext="{Binding ReleaseCard}"/>
            <Expander Header="Use an installer already on this PC" Margin="0,12,0,0">
                <Button Content="Choose installer file" Command="{Binding SelectExistingCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </Expander>
            <Expander Header="This PC" Margin="0,14,0,0">
                <StackPanel>
                    
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Graphics" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.GpuName}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PCI vendor / device" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                            <Run Text="VEN_"/><Run Text="{Binding Hardware.VendorId, Mode=OneWay}"/>
                            <Run Text="  DEV_"/><Run Text="{Binding Hardware.DeviceId, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed driver" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                            <Run Text="{Binding Hardware.DriverVersion, Mode=OneWay}"/>
                            <Run Text="  ("/><Run Text="{Binding Hardware.DriverDate, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                            <Run Text="{Binding Hardware.WindowsVersion, Mode=OneWay}"/>
                            <Run Text="  build "/><Run Text="{Binding Hardware.WindowsBuild, Mode=OneWay}"/>
                            <Run Text="  "/><Run Text="{Binding Hardware.Architecture, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="AMD Software" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0">
                            <Run Text="{Binding Hardware.AmdSoftwareDetected, Mode=OneWay}"/>
                            <Run Text="  "/><Run Text="{Binding Hardware.AmdSoftwareVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="ADLX available" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Hardware.IsAdlxAvailable}" Margin="0,6,0,0"/>
                    </Grid>
                </StackPanel>
            </Expander>


        </StackPanel>
    </ScrollViewer>
</UserControl>
