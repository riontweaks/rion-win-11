<UserControl x:Class="RadeonSoftwareSlimmer.Views.Wizard.AnalyzeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                       Text="The installer is extracted to an isolated workspace and its manifests are read. Your original installer file is never modified."/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Original installer" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Info.FilePath}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SHA-256" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Info.OriginalHashSha256}" Margin="0,6,0,0"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkspacePath}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </Grid>

                    <Button Content="Analyze Package" Style="{StaticResource AccentButton}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Command="{Binding AnalyzeCommand}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource StdBoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding SummaryVisible, Converter={StaticResource StdBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Component inventory" Style="{StaticResource H2}"/>
                    <UniformGrid Columns="4" Margin="0,10,0,0">
                        <StackPanel><TextBlock FontFamily="{StaticResource DisplayFont}" Text="{Binding PackageCount}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Packages" Style="{StaticResource Caption}"/></StackPanel>
                        <StackPanel><TextBlock FontFamily="{StaticResource DisplayFont}" Text="{Binding TaskCount}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Scheduled tasks" Style="{StaticResource Caption}"/></StackPanel>
                        <StackPanel><TextBlock FontFamily="{StaticResource DisplayFont}" Text="{Binding ComponentCount}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Display components" Style="{StaticResource Caption}"/></StackPanel>
                        <StackPanel><TextBlock FontFamily="{StaticResource DisplayFont}" Text="{Binding UnknownCount}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Unknown files" Style="{StaticResource Caption}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
